{
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(supabase start)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(sudo *)",
      "Read(.env)",
      "Read(.env.*)",
      "Bash(pnpm db *)",
      "Bash(prisma)"
    ]
  },
  "enabledPlugins": {
    "agent-skills@hey-now-jp": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "includeCoAuthoredBy": false
}
